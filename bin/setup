#!/bin/bash
set -e

if docker compose version >/dev/null 2>&1; then
  COMPOSE_CMD="docker compose"
elif command -v docker-compose >/dev/null 2>&1; then
  COMPOSE_CMD="docker-compose"
else
  echo "ERROR: Docker Compose not found. Install Docker Compose plugin or docker-compose binary."
  exit 1
fi

echo "== Copying .env.example to .env (if not exists) =="
[ -f .env ] || cp .env.example .env

echo "== Building containers =="
$COMPOSE_CMD build

echo "== Setting up database =="
$COMPOSE_CMD run --rm rails rails db:create db:migrate db:seed

echo "== Setup complete. Run: $COMPOSE_CMD up =="
